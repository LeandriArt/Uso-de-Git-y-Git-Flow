@model Tienda.Inventario.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>

<div class="alert alert-warning">
    ¿Seguro que deseas eliminar este producto?
    Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">RD$ @Model.Precio.ToString("N2")</dd>

    <dt class="col-sm-3">Cantidad</dt>
    <dd class="col-sm-9">@Model.Cantidad</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">
        Confirmar eliminación
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>